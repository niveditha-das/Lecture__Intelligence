# copy to .env
DATABASE_URL=postgresql://lia:lia@localhost:5433/lia
STORAGE_DIR=./storage

# Embeddings run locally (BAAI/bge-m3) — no key needed, ~3s per query on CPU.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1024

# Generation. Any OpenAI-compatible endpoint works; the example below is
# Gemini's, which has a free tier.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite

# Model names change often — these are strings, not constants, and one provider
# model was retired mid-build. Check what your key can reach.

RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K=6

# Seconds between model calls. Free tiers cap around 15/min; the SDK's own
# retries fire in milliseconds and just burn quota, so pacing happens here.
LLM_MIN_INTERVAL=4.5
